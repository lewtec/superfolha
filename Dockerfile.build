# Full multi-stage build for local/CI `docker build` and platforms that build
# from source (Railway/Render). Production releases use GoReleaser + root Dockerfile
# (texlive base + prebuilt binary).
#
# Frontend + templ codegen is `go generate ./...` (see generate.go). Do not
# re-list bun scripts here — that is how this image drifted from local builds.

FROM oven/bun:1.4.1-debian@sha256:8a74444991f5b3acbdbfa1f8983e2ac9df58dc98652636a1a641fafb4f287a17 AS bun

FROM golang:1.25-bookworm AS builder

WORKDIR /build

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go generate ./...

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /build/server ./cmd/superfolha

# Stage 3: runtime with TeX Live + latexmk
FROM texlive/texlive:latest@sha256:bd551dda2195c6830bb714f731d74c4f71cda812178abae15a206fd68b5dbb7c

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/server /app/server

EXPOSE 8080

ENV STATE_DIR=/data
ENV PORT=8080

RUN mkdir -p /data

ENTRYPOINT ["/app/server"]

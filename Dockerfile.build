# Full multi-stage build for local/CI `docker build` and platforms that build
# from source (Railway/Render). Production releases use GoReleaser + root Dockerfile
# (texlive base + prebuilt binary).

# Stage 1: CSS + editor island
FROM oven/bun:1.3.8-debian AS assets

WORKDIR /src
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile || bun install
COPY internal/web/input.css internal/web/input.css
COPY internal/ui internal/ui
COPY web/editor web/editor
RUN bun run build:css && bun run build:editor

# Stage 2: Go binary (embeds /static + templ)
FROM golang:1.25-bookworm AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=assets /src/internal/web/static ./internal/web/static

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /build/server ./cmd/superfolha

# Stage 3: runtime with TeX Live + latexmk
FROM texlive/texlive:latest@sha256:bd551dda2195c6830bb714f731d74c4f71cda812178abae15a206fd68b5dbb7c

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/server /app/server

EXPOSE 8080

ENV STATE_DIR=/data
ENV PORT=8080

RUN mkdir -p /data

ENTRYPOINT ["/app/server"]

# Full multi-stage build for local/CI `docker build` and platforms that build
# from source (Railway/Render). Production releases use GoReleaser + root Dockerfile
# (texlive base + prebuilt binary).
#
# Frontend + templ codegen is `go generate ./...` (see generate.go). Do not
# re-list bun scripts here — that is how this image drifted from local builds.

FROM oven/bun:1.3.8-debian AS bun

FROM golang:1.27-bookworm AS builder

WORKDIR /build

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go generate ./...

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /build/server ./cmd/superfolha

# Stage 3: runtime with TeX Live + latexmk
FROM texlive/texlive:latest@sha256:16c556aeb4095b47245fcd05db47061529e5df8fc8c04d97fb0f049055244526

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/server /app/server

EXPOSE 8080

ENV STATE_DIR=/data
ENV PORT=8080

RUN mkdir -p /data

ENTRYPOINT ["/app/server"]

# Full multi-stage build for local/CI `docker build` and platforms that build
# from source (Railway/Render). Production releases use GoReleaser + root Dockerfile
# (texlive base + prebuilt binary).

# Stage 1: build frontend (SPA assets embedded into Go binary)
FROM oven/bun:1.4.0-debian@sha256:5bb0f9be3a1a36a03e27c9a9dd894a3b1ad26657155c7df4dda771e17bf872ef AS frontend

WORKDIR /src/frontend

COPY frontend/package.json frontend/bun.lock ./
RUN bun install --frozen-lockfile

COPY frontend/ ./
# vite outDir: ../internal/server/web/dist → /src/internal/server/web/dist
RUN bun run build

# Stage 2: build Go binary with release tag (embeds SPA)
FROM golang:1.25-bookworm AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=frontend /src/internal/server/web/dist ./internal/server/web/dist

RUN CGO_ENABLED=0 GOOS=linux go build -tags release -trimpath -ldflags="-s -w" -o /build/server ./cmd/superfolha

# Stage 3: runtime with TeX Live + latexmk
FROM texlive/texlive:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/server /app/server

EXPOSE 8080

ENV STATE_DIR=/data
ENV PORT=8080

RUN mkdir -p /data

ENTRYPOINT ["/app/server"]

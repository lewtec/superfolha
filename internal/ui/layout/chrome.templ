package layout

import "github.com/lewtec/superfolha/internal/paths"

templ ThemeToggle(c Chrome) {
	<button
		type="button"
		class="btn btn-ghost btn-square min-h-[var(--touch-min)] min-w-[var(--touch-min)]"
		onclick="window.__sfTheme && window.__sfTheme.toggle()"
		aria-label={ c.T("common.theme") }
		title={ c.T("common.theme") }
	>
		<svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"></path>
		</svg>
	</button>
}

templ LangSelect(c Chrome, next string) {
	<form method="post" action={ paths.Lang() } class="inline">
		<input type="hidden" name="next" value={ next }/>
		<label class="sr-only" for="lang-select">{ c.T("common.language") }</label>
		<select
			id="lang-select"
			name="lang"
			class="select select-bordered select-sm min-h-[var(--touch-min)] max-w-[5.5rem]"
			onchange="this.form.submit()"
			aria-label={ c.T("common.language") }
		>
			<option value="en" selected?={ c.Lang == "en" }>EN</option>
			<option value="pt" selected?={ c.Lang == "pt" }>PT</option>
			<option value="es" selected?={ c.Lang == "es" }>ES</option>
		</select>
	</form>
}

templ IdentityMenu(c Chrome) {
	<div
		id="sf-ident"
		data-login={ c.Email }
		data-challenge={ paths.LoginChallenge() }
		data-verify={ paths.LoginVerify() }
		data-logout={ paths.Logout() }
		data-title={ c.T("auth.identities") }
		data-add-label={ c.T("auth.add_identity") }
		data-new-label={ c.T("auth.new_identity") }
		data-leave-label={ c.T("common.leave") }
		data-invite-label={ c.T("sessions.invite") }
		data-invite-action={ c.InviteAction }
		data-invite-copied={ c.T("sessions.invite_copied") }
		data-commit-label={ c.CommitLabel }
		data-theme-label={ c.T("common.theme") }
		data-theme-light={ c.T("common.theme_light") }
		data-theme-dark={ c.T("common.theme_dark") }
		data-signed-in={ c.T("common.signed_in_as") }
		data-lang-label={ c.T("common.language") }
		data-lang={ c.Lang }
		data-lang-next={ c.LangNext }
		data-lang-action={ paths.Lang() }
		data-bad-key={ c.T("auth.key_bad") }
		data-working={ c.T("auth.signing_in") }
		data-no-file={ c.T("auth.no_file") }
	>
		<button
			id="sf-ident-btn"
			type="button"
			class="btn btn-ghost btn-sm gap-2 min-h-[var(--touch-min)]"
			style="anchor-name:--sf-ident"
			aria-haspopup="menu"
			aria-expanded="false"
			aria-controls="sf-ident-menu"
			aria-label={ c.T("auth.identities") }
		>
			<div class="avatar avatar-placeholder">
				<div class="bg-neutral text-neutral-content w-8 rounded-full">
					<span id="sf-ident-initials">?</span>
				</div>
			</div>
			<span id="sf-ident-label" class="hidden sm:inline font-mono text-xs">{ c.Email }</span>
		</button>
		<ul
			id="sf-ident-menu"
			class="dropdown menu menu-sm dropdown-end w-80 rounded-box bg-base-100 p-2 shadow-sm"
			popover="manual"
			style="position-anchor:--sf-ident;position-area:bottom span-left"
		></ul>
		<form id="sf-ident-leave" method="post" action={ paths.Logout() } class="hidden"></form>
		@LocalWarnPanel(c)
	</div>
	<dialog id="sf-ident-load" class="modal">
		<div class="modal-box">
			<h3 class="text-lg font-bold">{ c.T("auth.add_identity") }</h3>
			<fieldset class="fieldset mt-4">
				<legend class="fieldset-legend">{ c.T("auth.choose_key") }</legend>
				<input id="sf-ident-file" class="file-input w-full" type="file"/>
			</fieldset>
			<fieldset class="fieldset">
				<legend class="fieldset-legend">{ c.T("auth.key_pass") }</legend>
				<input id="sf-ident-pass" class="input w-full" type="password" autocomplete="off" placeholder={ c.T("auth.key_pass") }/>
				<p class="label">{ c.T("auth.key_file_hint") }</p>
			</fieldset>
			<p id="sf-ident-load-status" class="text-sm text-base-content/70 mt-2"></p>
			<div class="modal-action">
				<form method="dialog">
					<button class="btn">{ c.T("common.cancel") }</button>
				</form>
				<button type="button" class="btn btn-primary" id="sf-ident-load-ok" disabled>{ c.T("auth.confirm_identity") }</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ c.T("common.cancel") }</button>
		</form>
	</dialog>
	<div id="sf-ident-toast" class="toast toast-end toast-bottom z-50 hidden">
		<div class="alert" role="status">
			<span id="sf-ident-toast-msg"></span>
		</div>
	</div>
	<script src={ paths.ChromeJS() }></script>
}

templ Icon(d string) {
	<svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={ d }></path>
	</svg>
}

templ LocalWarn(c Chrome) {
	<button
		type="button"
		class="btn btn-ghost btn-xs btn-square text-warning shrink-0"
		onclick="document.getElementById('sf-local-warn')?.showModal()"
		aria-label={ c.T("sessions.local_warn_title") }
	>
		@Icon("M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z")
	</button>
}

templ LocalWarnPanel(c Chrome) {
	<dialog id="sf-local-warn" class="modal">
		<div class="modal-box w-80 max-w-[min(20rem,calc(100vw-2rem))]">
			<h3 class="text-lg font-bold">{ c.T("sessions.local_warn_title") }</h3>
			<p class="py-3">{ c.T("sessions.local_warn_body") }</p>
			<div class="modal-action">
				<form method="dialog">
					<button class="btn">{ c.T("common.cancel") }</button>
				</form>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ c.T("common.cancel") }</button>
		</form>
	</dialog>
}

templ BrandMark() {
	<img src={ paths.BrandLogo() } alt="" width="32" height="32" class="h-8 w-8 shrink-0 object-contain" decoding="async"/>
}

templ flashes(c Chrome) {
	if c.Error != "" {
		<div class="alert alert-error mx-auto max-w-3xl my-4" role="alert">
			<span>{ c.Error }</span>
		</div>
	}
	if c.Flash != "" {
		<div class="alert alert-success mx-auto max-w-3xl my-4" role="status">
			<span>{ c.Flash }</span>
		</div>
	}
}

// AuthShell: landing / login / register — no product nav extras.
templ AuthShell(c Chrome) {
	@Document(c) {
		<body class="min-h-dvh bg-base-200 text-base-content">
			<header class="navbar app-navbar border-b border-base-300 bg-base-100 px-2 sm:px-4">
				<div class="navbar-start">
					<a href={ paths.Landing } class="btn btn-ghost h-10 min-h-10 gap-2 px-2" aria-label="Superfolha">
						@BrandMark()
						<span class="hidden sm:inline font-semibold">{ c.T("common.app_name") }</span>
					</a>
				</div>
				<div class="navbar-end gap-1 sm:gap-2">
					@LangSelect(c, "/")
					@ThemeToggle(c)
					if c.LoggedIn {
						<a class="btn btn-sm btn-primary" href={ paths.Projects() }>{ c.T("common.my_projects") }</a>
					} else {
						<a class="btn btn-sm btn-primary" href={ paths.Login() }>{ c.T("auth.login_button") }</a>
					}
				</div>
			</header>
			<main>
				@flashes(c)
				{ children... }
			</main>
		</body>
	}
}

// AppShell: logged-in chrome (projects).
templ AppShell(c Chrome) {
	@Document(c) {
		<body class="min-h-dvh bg-base-200 text-base-content">
			<header class="navbar app-navbar border-b border-base-300 bg-base-100 px-2 sm:px-4">
				<div class="navbar-start">
					<a href={ paths.Projects() } class="btn btn-ghost h-10 min-h-10 gap-2 px-2" aria-label={ c.T("common.app_name") }>
						@BrandMark()
						<span class="hidden sm:inline font-semibold">{ c.T("common.app_name") }</span>
					</a>
				</div>
				<div class="navbar-end gap-1 sm:gap-2 items-center">
					if c.Email != "" {
						@IdentityMenu(c)
					}
				</div>
			</header>
			<main class="app-main">
				@flashes(c)
				{ children... }
			</main>
		</body>
	}
}

// EditorShell: product chrome plus island slot in children (nav extras via children start).
templ EditorShell(c Chrome) {
	@Document(c) {
		<body class="h-dvh overflow-hidden bg-base-100 text-base-content">
			{ children... }
		</body>
	}
}

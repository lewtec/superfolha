package pages

import (
	"github.com/lewtec/superfolha/internal/paths"
	"github.com/lewtec/superfolha/internal/ui/layout"
)

templ Landing(c layout.Chrome) {
	@layout.AuthShell(c) {
		<section class="hero min-h-[calc(100dvh-var(--shell-height))] bg-base-200">
			<div class="hero-content text-center">
				<div class="max-w-md">
					<img src={ paths.BrandLogo() } alt="" width="96" height="96" class="mx-auto mb-6 h-24 w-24"/>
					<h1 class="text-5xl font-bold">{ c.T("landing.landing_title") }</h1>
					<p class="py-6">{ c.T("landing.landing_subtitle") }</p>
					if c.LoggedIn {
						<a href={ paths.Projects() } class="btn btn-primary">{ c.T("common.my_projects") }</a>
					} else {
						<a href={ paths.Login() } class="btn btn-primary">{ c.T("landing.landing_cta") }</a>
					}
				</div>
			</div>
		</section>
		<section class="container mx-auto px-4 py-20">
			<h2 class="text-4xl font-bold text-center mb-12">{ c.T("landing.features_title") }</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="card bg-base-100 shadow-xl">
					<div class="card-body">
						<h3 class="card-title">{ c.T("landing.feature1_title") }</h3>
						<p>{ c.T("landing.feature1_description") }</p>
					</div>
				</div>
				<div class="card bg-base-100 shadow-xl">
					<div class="card-body">
						<h3 class="card-title">{ c.T("landing.feature2_title") }</h3>
						<p>{ c.T("landing.feature2_description") }</p>
					</div>
				</div>
				<div class="card bg-base-100 shadow-xl">
					<div class="card-body">
						<h3 class="card-title">{ c.T("landing.feature3_title") }</h3>
						<p>{ c.T("landing.feature3_description") }</p>
					</div>
				</div>
			</div>
		</section>
		<section class="bg-base-200">
			<div class="container mx-auto px-4 py-20">
				<h2 class="text-4xl font-bold text-center mb-12">{ c.T("landing.testimonials_title") }</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="card bg-base-100 shadow-xl">
						<div class="card-body">
							<p>"{ c.T("landing.testimonial1_text") }"</p>
							<p class="font-bold mt-4">{ c.T("landing.testimonial1_author") }</p>
						</div>
					</div>
					<div class="card bg-base-100 shadow-xl">
						<div class="card-body">
							<p>"{ c.T("landing.testimonial2_text") }"</p>
							<p class="font-bold mt-4">{ c.T("landing.testimonial2_author") }</p>
						</div>
					</div>
					<div class="card bg-base-100 shadow-xl">
						<div class="card-body">
							<p>"{ c.T("landing.testimonial3_text") }"</p>
							<p class="font-bold mt-4">{ c.T("landing.testimonial3_author") }</p>
						</div>
					</div>
				</div>
			</div>
		</section>
		<section class="container mx-auto px-4 py-20 text-center">
			<h2 class="text-4xl font-bold mb-4">{ c.T("landing.final_cta_title") }</h2>
			<p class="text-xl mb-8">{ c.T("landing.final_cta_subtitle") }</p>
			if c.LoggedIn {
				<a href={ paths.Projects() } class="btn btn-primary">{ c.T("common.my_projects") }</a>
			} else {
				<a href={ paths.Login() } class="btn btn-primary">{ c.T("landing.final_cta_button") }</a>
			}
		</section>
		<footer class="bg-base-300 text-base-content">
			<div class="container mx-auto px-4 py-6 text-center">
				<p>{ c.T("landing.footer_text") }</p>
			</div>
		</footer>
	}
}

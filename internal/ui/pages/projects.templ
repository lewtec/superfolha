package pages

import (
	"github.com/lewtec/superfolha/internal/paths"
	"github.com/lewtec/superfolha/internal/remote"
	"github.com/lewtec/superfolha/internal/session"
	"github.com/lewtec/superfolha/internal/ui/layout"
)

templ Sessions(c layout.Chrome, items []session.Info) {
	@layout.AppShell(c) {
		<div class="container mx-auto px-4 py-6 space-y-8">
			if len(items) > 0 {
				<section>
					<h1 class="text-xl font-semibold mb-3">{ c.T("sessions.title") }</h1>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
						for _, item := range items {
							<div
								class="card bg-base-100 border border-base-300"
								data-sf-live
								data-remote={ item.CloneURL }
								data-branch={ item.Branch }
								data-editor={ paths.Editor(item.ID) }
								data-ready={ readyFlag(item.Ready) }
							>
								<div class="card-body">
									<h2 class="card-title break-all text-base">{ sessionTitle(item) }</h2>
									<p class="text-sm text-base-content/70">
										{ item.Branch }
										if item.Ephemeral {
											<span class="badge badge-ghost badge-sm ms-2">{ c.T("sessions.ephemeral") }</span>
										}
									</p>
									if !item.Ready && item.SSHPublic != "" {
										<button type="button" class="btn btn-sm" onclick="document.getElementById('ssh-deploy-modal')?.showModal()">{ c.T("sessions.ssh_key") }</button>
									}
									<div class="card-actions justify-end mt-2">
										if item.Ready {
											<a class="btn btn-primary btn-sm" href={ paths.Editor(item.ID) }>{ c.T("common.open") }</a>
										} else if item.HostLogin == c.Email {
											<button type="button" class="btn btn-primary btn-sm" data-ws={ paths.SessionWS(item.ID) } data-editor={ paths.Editor(item.ID) } data-remote={ item.CloneURL } data-branch={ item.Branch } data-retry-clone>{ c.T("sessions.retry_clone") }</button>
										}
										if item.HostLogin == c.Email {
											<form method="post" action={ paths.ProjectDelete(item.ID) } onsubmit="return confirm(this.dataset.confirm)" data-confirm={ c.T("sessions.end_confirm") }>
												<button class="btn btn-error btn-sm" type="submit">{ c.T("sessions.end") }</button>
											</form>
										} else {
											<form method="post" action={ paths.SessionKnock(item.ID) }>
												<button class="btn btn-ghost btn-sm" type="submit">{ c.T("sessions.knock") }</button>
											</form>
										}
									</div>
								</div>
							</div>
						}
					</div>
				</section>
			}
			<section id="sf-recents-wrap" class="hidden">
				<h2 class="text-xl font-semibold mb-3">{ c.T("sessions.recents") }</h2>
				<ul
					id="sf-recents"
					class="list bg-base-100 rounded-box border border-base-300"
					data-label-resume={ c.T("sessions.resume") }
					data-label-open={ c.T("common.open") }
					data-label-forget={ c.T("sessions.forget") }
				></ul>
			</section>
			<div class="card bg-base-100 border border-base-300">
				<div class="card-body">
					<h2 class="card-title">{ c.T("sessions.start") }</h2>
					<p id="sf-start-hint" class="text-sm text-base-content/70">{ c.T("sessions.start_hint") }</p>
					<form
						id="sf-session-form"
						method="post"
						action={ paths.Projects() }
						class="space-y-4"
						data-hint-ssh={ c.T("sessions.start_hint") }
						data-hint-local={ c.T("sessions.ephemeral_hint") }
					>
						<fieldset class="fieldset">
							<legend class="fieldset-legend">{ c.T("sessions.remote_label") }</legend>
							<input id="sf-remote" class="input w-full font-mono" type="text" name="remote" required placeholder="git@github.com:org/paper or /tmp/paper" spellcheck="false" autocomplete="off"/>
						</fieldset>
						<fieldset class="fieldset">
							<legend class="fieldset-legend">{ c.T("sessions.branch_label") }</legend>
							<input id="sf-branch" class="input w-full" type="text" name="branch" placeholder="main"/>
						</fieldset>
						<fieldset id="sf-ssh-box" class="fieldset">
							<legend class="fieldset-legend">{ c.T("sessions.ssh_key_local") }</legend>
							<textarea id="sf-ssh-pub" class="textarea font-mono text-xs w-full" readonly rows="2"></textarea>
							<input type="hidden" name="ssh_public" id="sf-ssh-public"/>
							<input type="password" id="sf-ssh-pass" class="input w-full hidden" autocomplete="off" placeholder={ c.T("auth.key_pass") }/>
							<input type="file" id="sf-ssh-file" class="hidden"/>
							<div class="flex flex-wrap gap-2 mt-2">
								<button type="button" class="btn" id="sf-ssh-store">{ c.T("auth.store_key") }</button>
								<button type="button" class="btn" id="sf-ssh-load">{ c.T("auth.load_key") }</button>
								<button type="button" class="btn" data-copy-ssh="sf-ssh-pub">{ c.T("sessions.copy_key") }</button>
							</div>
							<p class="label">{ c.T("sessions.ssh_key_hint") }</p>
						</fieldset>
						<button class="btn btn-primary" type="submit">{ c.T("sessions.clone") }</button>
					</form>
				</div>
			</div>
			if first, ok := firstPending(items); ok {
				<dialog id="ssh-deploy-modal" class="modal">
					<div class="modal-box">
						<h3 class="text-lg font-bold">{ c.T("sessions.add_ssh_key") }</h3>
						<p class="py-2 text-sm font-mono break-all">{ sessionTitle(first) } · { first.Branch }</p>
						<label class="form-control w-full">
							<span class="label-text">{ c.T("sessions.ssh_key") }</span>
							<textarea class="textarea font-mono text-xs w-full" readonly rows="4" id={ "ssh-" + first.ID }>{ first.SSHPublic }</textarea>
						</label>
						<div class="modal-action">
							<button type="button" class="btn" data-copy-ssh={ "ssh-" + first.ID }>{ c.T("sessions.copy_key") }</button>
							<button type="button" class="btn btn-primary" id="sf-ssh-retry" data-ws={ paths.SessionWS(first.ID) } data-editor={ paths.Editor(first.ID) } data-remote={ first.CloneURL } data-branch={ first.Branch }>{ c.T("sessions.retry_clone") }</button>
							<form method="dialog">
								<button class="btn btn-ghost">{ c.T("common.cancel") }</button>
							</form>
						</div>
					</div>
					<form method="dialog" class="modal-backdrop">
						<button>{ c.T("common.cancel") }</button>
					</form>
				</dialog>
			}
		</div>
		<div
			id="sf-clone-toast"
			class="toast toast-end toast-bottom z-50 hidden"
			data-working={ c.T("sessions.cloning") }
			data-failed={ c.T("sessions.clone_failed") }
			data-timeout={ c.T("sessions.clone_timeout") }
			data-unauthorized={ c.T("sessions.key_unauthorized") }
			data-readonly={ c.T("sessions.key_read_only") }
		>
			<div id="sf-clone-alert" class="alert" role="status">
				<span id="sf-clone-spin" class="loading loading-spinner hidden"></span>
				<span id="sf-clone-msg"></span>
			</div>
		</div>
		<script>
			document.addEventListener("click", function (e) {
				var t = e.target;
				if (t && t.nodeType !== 1) t = t.parentElement;
				if (!t || !t.closest) return;
				var b = t.closest("[data-copy-ssh]");
				if (!b) return;
				var el = document.getElementById(b.getAttribute("data-copy-ssh"));
				if (!el) return;
				if (window.isSecureContext && navigator.clipboard && navigator.clipboard.writeText) {
					navigator.clipboard.writeText(el.value);
					return;
				}
				el.focus();
				el.select();
				el.setSelectionRange(0, el.value.length);
				document.execCommand("copy");
			});
		</script>
		<script src={ paths.SessionsJS() }></script>
	}
}

func sessionTitle(item session.Info) string {
	if item.CloneURL != "" {
		return remote.Display(item.CloneURL)
	}
	return remote.Display(item.Remote)
}

func readyFlag(ok bool) string {
	if ok {
		return "1"
	}
	return "0"
}

func firstPending(items []session.Info) (session.Info, bool) {
	for _, item := range items {
		if !item.Ready && item.SSHPublic != "" {
			return item, true
		}
	}
	return session.Info{}, false
}

package pages

import (
	"github.com/lewtec/superfolha/internal/paths"
	"github.com/lewtec/superfolha/internal/session"
	"github.com/lewtec/superfolha/internal/ui/layout"
)

templ Sessions(c layout.Chrome, items []session.Info) {
	@layout.AppShell(c) {
		<div class="container mx-auto px-4 py-8">
			<div class="flex justify-between items-center mb-6 gap-2 flex-wrap">
				<h1 class="text-3xl font-bold">{ c.T("sessions.title") }</h1>
			</div>
			<div class="card bg-base-100 shadow-xl mb-8">
				<div class="card-body">
					<h2 class="card-title">{ c.T("sessions.start") }</h2>
					<p class="text-sm text-base-content/70">{ c.T("sessions.start_hint") }</p>
					<form method="post" action={ paths.Projects() } class="space-y-4">
						<label class="form-control w-full">
							<span class="label-text">{ c.T("sessions.remote_label") }</span>
							<input class="input input-bordered w-full font-mono" type="text" name="remote" required placeholder="git@github.com:org/paper" spellcheck="false" autocomplete="off"/>
						</label>
						<label class="form-control w-full">
							<span class="label-text">{ c.T("sessions.branch_label") }</span>
							<input class="input input-bordered w-full" type="text" name="branch" placeholder="main"/>
						</label>
						<button class="btn btn-primary" type="submit">{ c.T("sessions.clone") }</button>
					</form>
				</div>
			</div>
			if first, ok := firstPending(items); ok {
				<dialog id="ssh-deploy-modal" class="modal" open>
					<div class="modal-box">
						<h3 class="text-lg font-bold">{ c.T("sessions.add_ssh_key") }</h3>
						<p class="py-2 text-sm font-mono break-all">{ sessionTitle(first) } · { first.Branch }</p>
						<label class="form-control w-full">
							<span class="label-text">{ c.T("sessions.ssh_key") }</span>
							<textarea class="textarea textarea-bordered font-mono text-xs w-full" readonly rows="4" id={ "ssh-" + first.ID }>{ first.SSHPublic }</textarea>
						</label>
						<div class="modal-action">
							<button type="button" class="btn" data-copy-ssh={ "ssh-" + first.ID }>{ c.T("sessions.copy_key") }</button>
							<form method="post" action={ paths.SessionRetry(first.ID) }>
								<button class="btn btn-primary" type="submit">{ c.T("sessions.retry_clone") }</button>
							</form>
							<form method="dialog">
								<button class="btn btn-ghost">{ c.T("common.cancel") }</button>
							</form>
						</div>
					</div>
					<form method="dialog" class="modal-backdrop">
						<button>{ c.T("common.cancel") }</button>
					</form>
				</dialog>
			}
			if len(items) == 0 {
				<p class="text-center text-base-content/70">{ c.T("sessions.empty") }</p>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					for _, item := range items {
						<div class="card bg-base-100 shadow-xl">
							<div class="card-body">
								<h2 class="card-title break-all">{ sessionTitle(item) }</h2>
								<p class="text-sm text-base-content/70">{ item.Branch }</p>
								<p class="text-xs font-mono text-base-content/50 break-all">{ item.ID }</p>
								if !item.Ready && item.SSHPublic != "" {
									<button type="button" class="btn btn-sm" onclick="document.getElementById('ssh-deploy-modal')?.showModal()">{ c.T("sessions.ssh_key") }</button>
								}
								<div class="card-actions justify-end mt-4">
									if item.Ready {
										<a class="btn btn-primary btn-sm" href={ paths.Editor(item.ID) }>{ c.T("common.open") }</a>
									} else if item.HostLogin == c.Email {
										<form method="post" action={ paths.SessionRetry(item.ID) }>
											<button class="btn btn-primary btn-sm" type="submit">{ c.T("sessions.retry_clone") }</button>
										</form>
									}
									if item.HostLogin == c.Email {
										<form method="post" action={ paths.ProjectDelete(item.ID) } onsubmit="return confirm(this.dataset.confirm)" data-confirm={ c.T("sessions.end_confirm") }>
											<button class="btn btn-error btn-sm" type="submit">{ c.T("sessions.end") }</button>
										</form>
									} else {
										<form method="post" action={ paths.SessionKnock(item.ID) }>
											<button class="btn btn-ghost btn-sm" type="submit">{ c.T("sessions.knock") }</button>
										</form>
									}
								</div>
							</div>
						</div>
					}
				</div>
			}
		</div>
		<script>
			document.addEventListener("click", function (e) {
				var t = e.target;
				if (t && t.nodeType !== 1) t = t.parentElement;
				if (!t || !t.closest) return;
				var b = t.closest("[data-copy-ssh]");
				if (!b) return;
				var el = document.getElementById(b.getAttribute("data-copy-ssh"));
				if (!el) return;
				if (window.isSecureContext && navigator.clipboard && navigator.clipboard.writeText) {
					navigator.clipboard.writeText(el.value);
					return;
				}
				el.focus();
				el.select();
				el.setSelectionRange(0, el.value.length);
				document.execCommand("copy");
			});
		</script>
	}
}

func sessionTitle(item session.Info) string {
	if item.CloneURL != "" {
		return item.CloneURL
	}
	return item.Remote
}

func firstPending(items []session.Info) (session.Info, bool) {
	for _, item := range items {
		if !item.Ready && item.SSHPublic != "" {
			return item, true
		}
	}
	return session.Info{}, false
}
